# Healthcare Memory Assistant - Environment Configuration Example
# Copy this file to .env and provide your actual secrets.
# NEVER commit .env to version control.

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database Configuration (PostgreSQL)
# Production: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database>
# Development/Offline fallback supported when LOCAL_SQLITE_FALLBACK=true
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/healthcare_memory
LOCAL_SQLITE_FALLBACK=true

# AI / LLM Configuration
# Google Gemini API Key (or OpenAI/compatible API key)
GEMINI_API_KEY=
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash

# Hindsight Agent Memory Service Configuration
# Official Hindsight memory server endpoint (self-hosted or Hindsight Cloud)
HINDSIGHT_BASE_URL=http://localhost:8888
HINDSIGHT_API_KEY=
HINDSIGHT_TIMEOUT_SECONDS=10

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
